# Copy to `.env` and fill in. Only VITE_* variables are read.
# These mirror the NEXT_PUBLIC_* values of the web-video frontend (frontend/.env).

# Backend API base URL — must end with /api
VITE_API_URL=http://localhost:4000/api

# Supabase project (same project as the web app)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Website opened by "Về trang chủ" links
VITE_SITE_URL=https://htstudiovn.com

# DEV ONLY: enter the Studio without signing in. Works only with `npm run dev`; ignored in builds.
# Nothing that needs an account (saving to Supabase, credits, generation) works in this mode.
# VITE_DEV_SKIP_AUTH=true
